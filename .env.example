# Copiez ce fichier en .env.local pour travailler en local.
# En ligne, ces valeurs se collent dans Netlify > Site configuration > Environment variables.

# Adresse publique du site, sans / final (ex. https://guichet-xxx.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe > Développeurs > Clés API (mode test : commence par sk_test_)
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > votre endpoint > Clé de signature (commence par whsec_)
STRIPE_WEBHOOK_SECRET=

# Resend > API Keys (commence par re_)
RESEND_API_KEY=
# L'adresse email avec laquelle vous avez créé votre compte Resend : c'est là qu'arrivent les nouvelles commandes
NOTIFY_EMAIL=

# Facultatif : Umami Cloud > Settings > Websites > Website ID
NEXT_PUBLIC_UMAMI_ID=
